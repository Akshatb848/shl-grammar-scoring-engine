# Optional settings read by the notebook via os.environ (they are NOT loaded from a .env file
# automatically; export them in your shell before starting Jupyter). No API keys are needed.

# Whisper model used for transcription (default: medium.en)
WHISPER_MODEL=medium.en
# 1 = drop score-0 (unusable) clips from training (default: 0, see notebook section 10)
DROP_ZERO=0
# Number of DeBERTa fine-tuning seeds to average (default: 3)
DEBERTA_SEEDS=3
# Output directory for plots and submission (default: outputs/ or outputs_nozero/)
OUTPUT_DIR=outputs
